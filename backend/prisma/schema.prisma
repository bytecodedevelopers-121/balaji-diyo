enum PaymentGateway {
  NABIL
  HBL
  NICA
  PACO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// Collapsed from 3 near-duplicate legacy tables (travel_payment_nabil/hbl/nica)
// — same modernization call as Media/Attachment. PACO has env config
// (PACO_ENABLE/PACO_API_KEY) but no dedicated model was found in code, so it's
// included here as a 4th gateway value pending confirmation. Re-split into
// per-gateway tables if the dump shows fields this shared shape can't hold.
model Payment {
  id            String         @id @default(cuid())
  gateway       PaymentGateway
  packageId     String?
  package       Package?       @relation(fields: [packageId], references: [id])
  // Set by the /book-now flow (booking is created first, then the PACO
  // checkout is initiated) so a booking's admin view can show whether it
  // was actually paid. Null for standalone /online-payment payments and
  // every legacy-migrated row.
  bookingId     String?
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  customTitle   String?
  customerName  String?
  customerEmail String?
  description   String?
  percentage    Int?
  totalAmount   Decimal        @db.Decimal(12, 2)
  // totalAmount is always the USD price. PACO charges in `currency`
  // (NPR since 2026-10-29): chargedAmount = round(totalAmount * exchangeRate),
  // exchangeRate = the live NRB USD→NPR rate used. Both null on legacy
  // rows / USD payments.
  currency       String         @default("USD") @db.VarChar(3)
  exchangeRate   Decimal?       @db.Decimal(12, 4)
  chargedAmount  Decimal?       @db.Decimal(14, 2)
  status        PaymentStatus  @default(PENDING)

  gatewayReference     String? // nabil_pay_id / hbl_order_id / nica_reference_no
  gatewayTransactionId String? // nica_transaction_id
  gatewaySignature     String? // nica_signature
  gatewaySessionId     String? // nabil_session_id / nabil_create_session_id
  requestPayload       Json? // create_request_order / execute_jose_payload
  responsePayload      Json? // create_order_response / nica_payload

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("payments")
}

// ==================== CONTACT ====================

model ContactMessage {
  id                String  @id @default(cuid())
  name              String
  email             String
  type              String
  url               String
  phone             String?
  message           String  @db.Text
  packageId         String?
  numberOfTraveller Int?
  ipAddress         String?
  // Resolved server-side from `ipAddress` via a best-effort IP-geolocation
  // lookup at submission time (see `lib/ip-geolocation.ts`) — not visitor
  // input, so both are null whenever the lookup fails/is skipped (private
  // IP, service down) rather than blocking the enquiry. Direct client
  // request 2026-09-07 ("country and ip address and country code should
  // go to admin mail"), distinct from the free-text "Your Country" the
  // visitor already picks on the form (that one's folded into `message`).
  country           String?
  countryCode       String?
  // Not in the legacy schema — added for the admin inbox UI (read/unread is
  // the practical minimum for a message list; skipping spam/archive states
  // as unwarranted complexity for what's a low-volume contact form).
  isRead            Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// Birthday greeting emails (lead booker only). `email` is always stored
// lowercased. The (email, year) unique key is what makes the daily job safe
// to re-run (e.g. the startup catch-up) without double-sending.
model BirthdayGreetingSent {
  id     String   @id @default(cuid())
  email  String
  year   Int
  sentAt DateTime @default(now())

  @@unique([email, year])
  @@map("birthday_greetings_sent")
}

model BirthdayOptOut {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("birthday_optouts")
}

