  passportImage String?
  photo         String?
  isLead        Boolean   @default(false)
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("travellers")
}

model CustomBooking {
