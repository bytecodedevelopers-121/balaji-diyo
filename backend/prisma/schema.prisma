  mapData     String? @db.Text // map_data — likely serialized GeoJSON, unconfirmed

  details ItineraryDetail[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("itineraries")
}

model ItineraryDetail {
  id                        String    @id @default(cuid())
  itineraryId               String
  itinerary                 Itinerary @relation(fields: [itineraryId], references: [id])
  // Global display position across the whole itinerary. itineraryDay/itineraryStop
  // describe the grouping, but neither can order the *days* themselves
  // (itineraryDay is free text — "Day 10" sorts before "Day 2"), so row order
  // is stamped explicitly on write.
  sortOrder                 Int       @default(0)
  itineraryDay              String
  itineraryTitle            String?
  itineraryShortDescription String?
  itineraryDescription      String?   @db.Text
  itineraryStop             Decimal?  @db.Decimal(6, 2)
  accommodation             String?
  meals                     String?
  // Per-day lunch stop, admin-entered (2026-09-02, client-requested) — the
  // public itinerary day card shows this next to `accommodation` ("Name of
  // hotel"), but unlike accommodation, nothing in the legacy migration had
  // an equivalent field to backfill from — every existing row starts null.
  lunchPlace                String?
  origin                    String?
  originCoordinate          String?
  originElevation           String?
  originPlaceId             String?
  originPlace               Place?    @relation("ItineraryOriginPlace", fields: [originPlaceId], references: [id])
  destination               String?
  destinationCoordinate     String?
  destinationElevation      String?
  destinationPlaceId        String?
  destinationPlace          Place?    @relation("ItineraryDestinationPlace", fields: [destinationPlaceId], references: [id])
  travelMode                String?
  distance                  String?
  duration                  String? // travel time for this leg, e.g. "15 Min"
  encodedPolyline           String?   @db.Text // Google-encoded polyline for drawing this leg's route
  footnote                  String?
  isActive                  Boolean   @default(true)

  facts ItineraryFact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("itinerary_details")
}

// Inferred by symmetry with PackageFact — no direct controller evidence found;
