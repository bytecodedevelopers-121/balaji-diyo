// ==================== TRAVEL: BOOKING / PAYMENT ====================

model Booking {
  id                String    @id @default(cuid())
  // Human-readable "BA-<number>" reference shown to the customer (email +
  // payment pages) — direct client request 2026-09-07: numbers must start
  // above 1443 (whatever count/log they're already using elsewhere), not
  // restart from 1. `id` (cuid) stays the real primary key/FK target
  // everywhere else; this is purely a customer-facing display number —
  // formatted as `BA-${bookingNumber}` in application code, not stored
  // with the prefix baked in. See the migration for the sequence's actual
  // starting value.
  bookingNumber     Int       @unique @default(autoincrement())
  packageId         String?
  package           Package?  @relation(fields: [packageId], references: [id])
  startDate         DateTime
  endDate           DateTime
  numberOfTraveller Int
  fullName          String
  email             String
  dateOfBirth       DateTime?
  nationality       String
  countryCode       String
  mobileNumber      String?
  pickupDetails     String?
  paymentOptions    String
  totalPrice        Decimal   @db.Decimal(12, 2)
  payablePercentage Int?
  ipAddress         String?

  invoice    Invoice?
  travellers Traveller[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

// Field shape inferred by symmetry with CustomTraveller — the packageBooking
// flow collects travellers in a separate step not fully covered in the code
// read so far; verify against the dump.
model Traveller {
  id            String    @id @default(cuid())
