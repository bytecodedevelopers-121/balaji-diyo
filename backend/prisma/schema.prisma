model ItineraryFact {
  id        String          @id @default(cuid())
  detailId  String
  detail    ItineraryDetail @relation(fields: [detailId], references: [id])
  factTitle String
  factValue String

  createdAt DateTime @default(now())

  @@map("itinerary_facts")
}

