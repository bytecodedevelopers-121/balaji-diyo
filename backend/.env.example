DATABASE_URL=""
PORT=5000
NODE_ENV=development

JWT_ACCESS_SECRET=your-super-long-random-access-secret-key
JWT_REFRESH_SECRET=your-super-long-random-refresh-secret-key

# Google Analytics 4 (admin dashboard) — optional. Without these two, the
# /api/analytics/dashboard endpoint returns { configured: false } and every
# widget renders empty instead of erroring.
# GA4_PROPERTY_ID: the numeric GA4 property id (Admin > Property Settings).
# GA4_SERVICE_ACCOUNT_KEY: the full service-account JSON key, as a single-line
# string, from a service account granted Viewer access to that GA4 property.
GA4_PROPERTY_ID=your_ga4_property_id
GA4_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Public base URL of the site — used to build payment gateway redirect URLs
# (success/fail/cancel) and webhook callback URLs, and to reach the
# frontend's cache-revalidation route (REVALIDATION_SECRET below).
PUBLIC_SITE_URL=http://localhost:3000

# Shared secret sent as the x-revalidate-secret header when POSTing to the
# frontend's app/api/revalidate route after a content mutation (team
# members today; more modules can reuse lib/revalidate-frontend.ts).
# Optional — without it, revalidateFrontendTags() just logs and no-ops,
# same shape as the optional GA4/PACO integrations below. Must match the
# frontend's own REVALIDATION_SECRET exactly.
REVALIDATION_SECRET=change-me-in-local-env

# PACO payment gateway (2c2p JOSE-secured API) — optional. Without
# PACO_ENABLED=true and all the keys below, POST /payments/paco/checkout
# returns 503 instead of attempting a call. No real credentials exist yet;
# these must come from your PACO/2c2p merchant onboarding, NOT from the old
# flamingo-base system (its credentials are a separate live merchant account
# and were flagged for rotation, not reuse).
PACO_ENABLED=false
PACO_API_BASE_URL=https://core.paco.2c2p.com/
PACO_MERCHANT_ID=
PACO_ACCESS_TOKEN=
# NPR reuses the USD credentials (same access token) by default. Optionally set
# any of PACO_NPR_MERCHANT_ID / _ENCRYPTION_KEY_ID / _MERCHANT_SIGNING_PRIVATE_KEY /
# _MERCHANT_DECRYPTION_PRIVATE_KEY / _ENCRYPTION_PUBLIC_KEY / _SIGNING_PUBLIC_KEY
# to override for NPR only (each falls back to the USD value).
PACO_NPR_ACCESS_TOKEN=
# USD (default) or NPR. NPR converts the USD price at the live NRB rate.
PACO_CHARGE_CURRENCY=USD
# Optional: public backend origin PACO calls back to (e.g. a dev tunnel URL).
# Unset = derived from the request host.
PACO_CALLBACK_BASE_URL=
PACO_ENCRYPTION_KEY_ID=
# Base64 DER, no PEM headers/newlines — the app wraps these itself. Legacy
# used the traditional "RSA PRIVATE KEY" (PKCS#1) header; if your PACO/2c2p
# onboarding instead issues PKCS#8 keys, see the header-detection comment in
# src/modules/payment/paco/paco.crypto.ts before assuming this is broken.
PACO_MERCHANT_SIGNING_PRIVATE_KEY=
PACO_MERCHANT_DECRYPTION_PRIVATE_KEY=
# PACO's own public keys (provided during onboarding), same base64-DER shape.
PACO_ENCRYPTION_PUBLIC_KEY=
PACO_SIGNING_PUBLIC_KEY=

# Booking-notification emails (lib/mail.ts) — optional, same "degrades
# cleanly" shape as PACO/GA4 above. Without SMTP_HOST/SMTP_USER/
# SMTP_PASSWORD, sendMail() just logs and skips instead of sending.
# BOOKING_ADMIN_EMAIL is checked separately — missing it only skips the
# admin "new booking" alert, not the customer confirmation email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@boundlessadventure.com
SMTP_FROM_NAME=Boundless Adventure
BOOKING_ADMIN_EMAIL=

# Cloudflare Turnstile — optional, same "degrades cleanly" shape as
# GA4/PACO/SMTP above. Protects the public enquiry/contact form
# (POST /contacts) and both booking forms (POST /bookings,
# POST /custom-bookings): without TURNSTILE_SECRET_KEY, verifyCaptcha
# (common/guards/captcha.guard.ts) skips the check entirely instead of
# rejecting every submission. Get a site key + secret key from a free
# Cloudflare account (dash.cloudflare.com > Turnstile) — the site key is
# public and goes in the frontend's NEXT_PUBLIC_TURNSTILE_SITE_KEY, the
# secret key below must never be exposed to the browser.
TURNSTILE_SECRET_KEY=

# MET Norway Locationforecast — free, no API key. Their terms require an
# identifying User-Agent containing a real application/domain and contact.
MET_WEATHER_USER_AGENT=BoundlessAdventure/1.0 support@boundlessadventure.com
