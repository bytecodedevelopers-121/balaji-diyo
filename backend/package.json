{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for the Boundless travel platform",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:content": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-content.ts",
    "seed:page-sections": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-page-sections.ts",
    "seed:trips": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-trips.ts",
    "migrate:himalayan": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/migrate-to-himalayan.ts",
    "cleanup:last-minute": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/cleanup-last-minute.ts",
    "seed:last-minute": "ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-last-minute.ts"
  },
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.108.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jod": "^0.0.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prisma": "^8.0.0-rc.34",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
