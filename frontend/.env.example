# Copy this file to .env.local for local development and fill in real
# values. See src/lib/env.ts for validation and README.md for more detail.

# --- Public (inlined into the browser bundle at build time — never put a --
# --- secret in a NEXT_PUBLIC_* variable) ------------------------------------

# This deploy's own public origin. Used to build canonical/absolute URLs
# and Open Graph/Twitter metadata. Must be the real origin for whichever
# tier is deploying — never a hardcoded production domain in source.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API base URL. Only meant for the rare Client Component that must
# call the API directly from the browser. Prefer API_URL (below) for
# Server Component / Route Handler data fetching — it never reaches the
# client bundle. Must include the "/api" prefix the Express app mounts
# its router under (backend/src/app.ts's `app.use("/api", apiRoutes)`) —
# apiFetch()'s callers pass paths like "/team-members", not "/api/...".
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Deployment tier: development | preview | staging | production.
# Drives robots/sitemap/canonical behavior — only "production" is
# indexable and gets canonical tags/sitemap entries (see
# src/lib/seo/canonical.ts). Defaults to "development" if unset.
NEXT_PUBLIC_APP_ENV=development

# Cloudflare Turnstile site key — read directly (not via src/lib/env.ts,
# same as NEXT_PUBLIC_API_URL in ContactForm.tsx) by every captcha-gated
# public form: ContactForm (and its TripEnquiryModal/trekking-route/blog
# reuses), PlanWithUsWizard, CheckoutView. Get one from a free Cloudflare
# account (dash.cloudflare.com > Turnstile) — until it's set, Captcha.tsx
# renders nothing and every form submits without a captcha step, exactly
# as before this feature existed. Must match the backend's
# TURNSTILE_SECRET_KEY (same Turnstile widget, different key of the pair).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID — read directly (not via
# src/lib/env.ts) by GoogleAnalytics.tsx, mounted globally in the root
# layout. Until it's set, that component renders nothing and no gtag.js
# is loaded, exactly as before this feature existed.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Server-only (never sent to the browser; read via src/lib/env.ts's ----
# --- getServerEnv(), which is guarded by the `server-only` package) --------

# Private API base URL for Server Component / Route Handler fetches. Can
# point at an internal network address in production. Same "/api" prefix
# requirement as NEXT_PUBLIC_API_URL above.
API_URL=http://localhost:5000/api

# Shared secret for the future cache-revalidation webhook
# (app/api/revalidate) and any other Next.js-owned route that needs to
# authenticate requests from the backend. Not yet consumed by any route.
REVALIDATION_SECRET=change-me-in-local-env
